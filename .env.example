# =============================================================================
# OPUS CARE SUPPORT SERVICES — ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. Supabase Connection (Sydney: ap-southeast-2)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_pub_...
# Alternative legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role Key (Private Server-Only)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# 2. Resend Email Delivery
RESEND_API_KEY=re_...
FROM_EMAIL=Opus Care <support@opuscare.com.au>
REFERRAL_TO_EMAIL=referrals@opuscare.com.au
CONTACT_TO_EMAIL=contact@opuscare.com.au

# 3. Operations CRM Access Security
ADMIN_ACCESS_KEY=your_secure_admin_password_here
